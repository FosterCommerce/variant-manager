{% if multipleFieldsExist == true %}
	<div class="variant-attributes-warning">
		<p>{{ 'field.multipleFieldsWarning'|t('variant-manager') }}</p>
		<p>{{ 'field.multipleFieldsIgnored'|t('variant-manager') }}</p>
	</div>
{% endif %}

<div class="variant-attributes-container">
	<table class="table data variant-attributes-table">
		<thead>
		<tr>
			<th class="singleline-cell textual text-right">{{ 'field.nameHeading'|t('variant-manager') }}</th>
			<th class="singleline-cell textual">{{ 'field.valueHeading'|t('variant-manager') }}</th>
		</tr>
		</thead>

		<tbody>
		{% for row in rows %}
			<tr>
				<td class="singleline-cell textual text-right">
					{%- if row.attribute -%}
						{{ elementChip(row.attribute) }}
					{%- else -%}
						{{ row.attributeName }}
					{%- endif -%}
				</td>
				<td class="singleline-cell textual">
					{%- if row.option -%}
						{{ elementChip(row.option) }}
					{%- else -%}
						{{ row.attributeValue }}
					{%- endif -%}
				</td>
			</tr>
		{% endfor %}
		</tbody>
	</table>
</div>

{% js %}
	(function() {
		const container = document.getElementById('{{ namespacedId }}-field');

		container.addEventListener('click', (clickEvent) => {
			const chip = clickEvent.target.closest('.chip.element[data-editable]');

			if (chip) {
				// Open a slideout instead of following the chip's edit link
				clickEvent.preventDefault();
				Craft.createElementEditor(chip.dataset.type, $(chip));
			}
		});
	})();
{% endjs %}
