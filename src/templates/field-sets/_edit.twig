{% import '_includes/forms.twig' as forms %}

{# @var fieldSet \fostercommerce\variantmanager\models\FieldSet #}

{% if fieldSet.uid %}{{ hiddenInput('fieldSetUid', fieldSet.uid) }}{% endif %}

{{ forms.textField({
	first: true,
	label: 'fieldSets.name'|t('variant-manager'),
	id: 'name',
	name: 'name',
	value: fieldSet.name,
	errors: fieldSet.getErrors('name'),
	autofocus: true,
	required: true,
	disabled: readOnly,
}) }}

{{ forms.textField({
	label: 'fieldSets.handle'|t('variant-manager'),
	instructions: 'fieldSets.handleInstructions'|t('variant-manager'),
	id: 'handle',
	class: 'code',
	name: 'handle',
	value: fieldSet.handle,
	errors: fieldSet.getErrors('handle'),
	required: true,
	disabled: readOnly,
}) }}

<hr>

{{ forms.fieldLayoutDesignerField({
	fieldLayout: fieldSet.getFieldLayout(),
	label: 'attributes.attributeLayout'|t('variant-manager'),
	instructions: 'attributes.attributeLayoutInstructions'|t('variant-manager'),
	disabled: readOnly,
}) }}

<hr>

{% namespace 'option-layout' %}
	{{ forms.fieldLayoutDesignerField({
		fieldLayout: fieldSet.getOptionFieldLayout(),
		label: 'attributes.optionLayout'|t('variant-manager'),
		instructions: 'attributes.optionLayoutInstructions'|t('variant-manager'),
		disabled: readOnly,
	}) }}
{% endnamespace %}

{% if not fieldSet.handle %}
	{% js %}
		new Craft.HandleGenerator("#{{ 'name'|namespaceInputId }}", "#{{ 'handle'|namespaceInputId }}");
	{% endjs %}
{% endif %}
