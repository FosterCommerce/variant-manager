{% extends '_layouts/cp.twig' %}
{% import '_includes/forms.twig' as forms %}

{# @var attribute \fostercommerce\variantmanager\elements\VariantAttribute #}
{# @var fieldSets \fostercommerce\variantmanager\models\FieldSet[] #}

{% set fullPageForm = true %}
{% set title = attribute.name %}

{% set crumbs = [
	{ label: 'Settings'|t('app'), url: url('settings') },
	{ label: 'Plugins'|t('app'), url: url('settings/plugins') },
	{ label: 'Variant Manager', url: url('variant-manager/settings') },
] %}

{% set fieldSetOptions = [{ label: 'fieldSets.none'|t('variant-manager'), value: '' }] %}
{% for fieldSet in fieldSets %}
	{% set fieldSetOptions = fieldSetOptions|merge([{ label: fieldSet.name, value: fieldSet.uid }]) %}
{% endfor %}

{% block content %}
	{{ actionInput('variant-manager/attributes/save-settings') }}
	{{ redirectInput('variant-manager/settings') }}
	{{ hiddenInput('attributeId', attribute.id) }}

	{{ forms.selectField({
		first: true,
		label: 'fieldSets.fieldSet'|t('variant-manager'),
		instructions: 'fieldSets.fieldSetInstructions'|t('variant-manager'),
		id: 'fieldSetUid',
		name: 'fieldSetUid',
		options: fieldSetOptions,
		value: attribute.fieldSetUid,
	}) }}
{% endblock %}
